# ~/.bashrc: executed by bash(1) for non-login interactive shells.

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# XDG and ~/ clean-up variables and PATH are set in ~/.profile (session-wide).

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
[ -d "${HISTFILE%/*}" ] || mkdir -p "${HISTFILE%/*}"

HISTCONTROL=ignoreboth      # skip duplicates and lines starting with a space
HISTSIZE=10000
HISTFILESIZE=20000

shopt -s histappend         # append to the history file, don't overwrite it
shopt -s cmdhist            # save multi-line commands as one entry

# ---------------------------------------------------------------------------
# Shell behaviour
# ---------------------------------------------------------------------------
# Update LINES and COLUMNS after each command if the window size changed
shopt -s checkwinsize

# Make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ---------------------------------------------------------------------------
# Prompt
# ---------------------------------------------------------------------------
# Identify the chroot you work in (shown in the prompt)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# If this is an xterm, set the window title to user@host:dir
case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
        ;;
esac

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
if [ -x /usr/bin/dircolors ]; then
    if [ -r ~/.dircolors ]; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# Colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
alias ll='ls -alF'

# ---------------------------------------------------------------------------
# Programmable completion (skip if already enabled in /etc/bash.bashrc)
# ---------------------------------------------------------------------------
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# ---------------------------------------------------------------------------
# Graphical session
# ---------------------------------------------------------------------------
# Key repeat: 300 ms delay, 50 repeats/s (X11 only; skipped over SSH/TTY)
if [ -n "$DISPLAY" ] && command -v xset >/dev/null 2>&1; then
    xset r rate 300 50 2>/dev/null
fi

# ---------------------------------------------------------------------------
# Custom 
# ---------------------------------------------------------------------------

# fzf key bindings and completion (ctrl-t, ctrl-r, alt-c); built into fzf >= 0.48
command -v fzf >/dev/null && eval "$(fzf --bash)"
