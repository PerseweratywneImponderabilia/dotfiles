# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# ---------------------------------------------------------------------------
# XDG base directories and ~/ clean-up.
# Kept here (not in ~/.bashrc) so the whole desktop session sees them:
# SDDM sources this file, so terminals, VS Code, KDE-launched and Java apps
# all use the same locations.
# ---------------------------------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Per-program settings, checked against wiki.archlinux.org/title/XDG_Base_Directory.
# Not set on purpose: GNUPGHOME (breaks systemd socket-activated gpg-agent),
# DOTNET_CLI_HOME / ANDROID_SDK_HOME (paths hardcoded), MBSYNCRC and
# NOTMUCH_CONFIG (not read / not needed), ANSIBLE_CONFIG (would override a
# project's own ansible.cfg), ANSIBLE_REMOTE_TEMP / ANSIBLE_ASYNC_DIR (these
# are paths on the managed hosts, not here).
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export WINEPREFIX="$XDG_DATA_HOME/wineprefixes/default"
export KODI_DATA="$XDG_DATA_HOME/kodi"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export TMUX_TMPDIR="$XDG_RUNTIME_DIR"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export ANSIBLE_HOME="$XDG_CONFIG_HOME/ansible"
export ANSIBLE_GALAXY_CACHE_DIR="$XDG_CACHE_HOME/ansible/galaxy_cache"
export ANSIBLE_LOCAL_TEMP="$XDG_CACHE_HOME/ansible/tmp"
export ANSIBLE_SSH_CONTROL_PATH_DIR="$XDG_CACHE_HOME/ansible/cp"
export UNISON="$XDG_DATA_HOME/unison"
export ELECTRUMDIR="$XDG_DATA_HOME/electrum"
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export PYTHONPYCACHEPREFIX="$XDG_CACHE_HOME/python"
export SQLITE_HISTORY="$XDG_STATE_HOME/sqlite_history"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"
export CODEX_HOME="$XDG_CONFIG_HOME/codex"
export COPILOT_HOME="$XDG_CONFIG_HOME/copilot"
export JUNIE_HOME="$XDG_CONFIG_HOME/junie"
export JUNIE_LOG_DIR="$JUNIE_HOME/logs"
export _JAVA_OPTIONS="-Djava.util.prefs.userRoot=$XDG_CONFIG_HOME/java -Djavafx.cachedir=$XDG_CACHE_HOME/openjfx"

# ---------------------------------------------------------------------------
# PATH: append ~/bin, the dcm4che tools, ~/.local/bin and all its
# subdirectories (skip __pycache__), without duplicating entries in nested
# shells. Set here, not in ~/.bashrc, so the desktop session (and apps started
# from the menu) get it.
# POSIX sh: this file is also read by /bin/sh when the login shell is not bash.
# ---------------------------------------------------------------------------
_path_add() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$PATH:$1" ;;
    esac
}
[ -d "$HOME/bin" ] && _path_add "$HOME/bin"
[ -d "$HOME/.local/applications/dcm4che-5/bin" ] && _path_add "$HOME/.local/applications/dcm4che-5/bin"
if [ -d "$HOME/.local/bin" ]; then
    _old_ifs=$IFS
    IFS='
'
    set -f
    for _dir in $(find "$HOME/.local/bin" -type d -name __pycache__ -prune -o -type d -print); do
        _path_add "$_dir"
    done
    set +f
    IFS=$_old_ifs
    unset _old_ifs _dir
fi
unset -f _path_add
export PATH

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

